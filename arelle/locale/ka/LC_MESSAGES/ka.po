#: arelle/CntlrCmdLine.py:1117
msgid "Test Options"
msgstr ""

#: arelle/CntlrCmdLine.py:1123
msgid ""
"For testcase results, specify comma separated additional expected errors "
"by test case id. `--testcaseExpectedErrors=testcase-"
"index.xml:test_id1|IOerror,oime:invalidTaxonomy`"
msgstr ""

#: arelle/CntlrCmdLine.py:1133
#, python-brace-format
msgid ""
"If any filters are provided, any testcase variation path in the form "
"{testcaseFilepath}:{testcaseVariationId} that doesn't pass any filter "
"will be skipped."
msgstr ""

#: arelle/CntlrCmdLine.py:1145
msgid ""
"Capture warning-level messages as validation results. Applies to testcase"
" variations, RSS feed items, and when used with `--validationExitCode`, "
"causes warnings to produce exit code `3`."
msgstr ""

#: arelle/CntlrCmdLine.py:1156
msgid ""
"For testcase results, default configuration is to pass if any expected "
"result is matched (`match-any`). Alternatively, require that all expected"
" results are matched (`match-all`)."
msgstr ""

#: arelle/CntlrCmdLine.py:1166
msgid "Configuration Options"
msgstr ""

#: arelle/CntlrCmdLine.py:1167
msgid ""
"It is possible to specify options to be defaults for the web server, such"
" as disclosureSystem and validations, but not including file names."
msgstr ""

#: arelle/CntlrCmdLine.py:1177
msgid ""
"Language for user interface (override system settings, such as program "
"messages).  Does not save setting. Requires locale country code, e.g. "
"`en-GB` or `en-US`."
msgstr ""

#: arelle/CntlrCmdLine.py:1187
msgid "Log info message for downloads to web cache."
msgstr ""

#: arelle/CntlrCmdLine.py:1193
msgid ""
"Abort process on major error, such as when load is unable to find an "
"entry or discovered file."
msgstr ""

#: arelle/CntlrCmdLine.py:1200
msgid ""
"Skip DTS activities (loading, discovery, validation), useful when an "
"instance needs only to be parsed."
msgstr ""

#: arelle/CntlrCmdLine.py:1208
msgid ""
"start web server on host:port[:server] for REST and web access, e.g., "
"`--webserver locahost:8080`, or specify nondefault a server name, such as"
" cheroot, `--webserver locahost:8080:cheroot`. (It is possible to specify"
" options to be defaults for the web server, such as disclosureSystem and "
"validations, but not including file names.)"
msgstr ""

#: arelle/CntlrCmdLine.py:1218
msgid "Internet Connectivity Arguments"
msgstr ""

#: arelle/CntlrCmdLine.py:1223
msgid ""
"Modify and re-save proxy settings configuration.  Enter `system` to use "
"system proxy setting, `none` to use no proxy, "
"`http://[user[:password]@]host[:port]`  (e.g., http://192.168.1.253, "
"http://example.com:8080, http://joe:secret@example.com:8080),  or `show` "
"to show current setting."
msgstr ""

#: arelle/CntlrCmdLine.py:1236
msgid ""
"Deprecated - use --workOffline or --workOnline. Specify internet "
"connectivity: `online` or `offline`"
msgstr ""

#: arelle/CntlrCmdLine.py:1243
#, python-brace-format
msgid ""
"Work offline, loading taxonomies and reports only from the local "
"filesystem. Defaults to the {0} environment variable, if set."
msgstr ""

#: arelle/CntlrCmdLine.py:1250
#, python-brace-format
msgid ""
"Work online, downloading taxonomies and reports that are not in the "
"cache. This is the default unless the {0} environment variable is set, so"
" this option can temporarily override it."
msgstr ""

#: arelle/CntlrCmdLine.py:1260
msgid "Specify internet connection timeout in seconds (0 means unlimited)."
msgstr ""

#: arelle/CntlrCmdLine.py:1268
#, python-brace-format
msgid ""
"Specify rechecking for newer cache files 'quarter-hourly', `hourly`, "
"`daily`, `weekly`, `monthly` or `never`. Defaults to the {0} environment "
"variable, if set."
msgstr ""

#: arelle/CntlrCmdLine.py:1278
msgid "Specify no checking of internet secure connection certificate"
msgstr ""

#: arelle/CntlrCmdLine.py:1285
msgid ""
"Treat http and https schemes interchangeably when looking up files from "
"the webcache"
msgstr ""

#: arelle/CntlrCmdLine.py:1292
msgid "Override the default location of the cache directory"
msgstr ""

#: arelle/CntlrCmdLine.py:1299
msgid "Specify non-standard http header User-Agent value"
msgstr ""

#: arelle/CntlrCmdLine.py:1305
msgid "Configuration Arguments"
msgstr ""

#: arelle/CntlrCmdLine.py:1312
msgid ""
"Provide a path to a JSON file containing runtime options. These options "
"will be overridden by any command line options provided."
msgstr ""

#: arelle/CntlrCmdLine.py:1321
msgid ""
"Specify non-standard location for configuration and cache files "
"(overrides environment parameter XDG_CONFIG_HOME)."
msgstr ""

#: arelle/CntlrCmdLine.py:1331
msgid "Prohibits Arelle from reading and writing a config to the local cache."
msgstr ""

#: arelle/CntlrCmdLine.py:1338
msgid ""
"Specify plug-in configuration for this invocation.  Enter `show` to "
"confirm plug-in configuration.  Commands show, and module urls are `|` "
"separated: url specifies a plug-in by its url or filename, relative URLs "
"are relative to installation plug-in directory,  (e.g., "
"'http://arelle.org/files/hello_web.py', 'C:\\Program "
"Files\\Arelle\\examples\\plugin\\hello_dolly.py' to load, or "
"../examples/plugin/hello_dolly.py for relative use of examples directory)"
" Local python files do not require .py suffix, e.g., hello_dolly without "
".py is sufficient, Packaged plug-in urls are their directory's url (e.g.,"
" `--plugins EDGAR/render` or `--plugins xbrlDB`).  "
msgstr ""

