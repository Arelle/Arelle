msgid ""
"Logging format for messages capture, otherwise default is "
"\"[%(messageCode)s] %(message)s - %(file)s\"."
msgstr ""

#: arelle/CntlrCmdLine.py:828
msgid ""
"Minimum level for messages capture, otherwise the message is ignored.  "
"Current order of levels are `debug`, `info`, `info-semantic`, `warning`, "
"`warning-semantic`, `warning`, `assertion-satisfied`, `inconsistency`, "
"`error-semantic`, `assertion-not-satisfied`, and `error`. "
msgstr ""

#: arelle/CntlrCmdLine.py:839
msgid ""
"Regular expression filter for logLevel.  (E.g., to not match *-semantic "
"levels, logLevelFilter=(?!^.*-semantic$)(.+). "
