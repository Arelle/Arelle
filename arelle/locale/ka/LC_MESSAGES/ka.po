msgstr ""

#: arelle/CntlrCmdLine.py:895
msgid "Formula Options"
msgstr ""

#: arelle/CntlrCmdLine.py:901
msgid ""
"Specify formula action: `validate` - validate only, without running, "
"`run` - validate and run, or `none` - prevent formula validation or "
"running when also specifying `-v` or `--validate`.  if this option is not"
" specified, `-v` or `--validate` will validate and run formulas if "
"present"
msgstr ""

#: arelle/CntlrCmdLine.py:914
msgid ""
"Specify formula/assertion IDs to run, separated by a `|` character, or a "
"regex expression."
msgstr ""

#: arelle/CntlrCmdLine.py:921
msgid "Specify formula are to be compiled but not executed."
msgstr ""

#: arelle/CntlrCmdLine.py:930
msgid ""
"Specify the number of fact aspect combinations to cache during formula "
"evaluations. Negative numbers have no limit. (10,000,000 is default)"
msgstr ""

#: arelle/CntlrCmdLine.py:941
msgid ""
"Maximum number of seconds per variable set evaluation before logging a "
"timeout error."
msgstr ""

#: arelle/CntlrCmdLine.py:949
msgid ""
"Maximum number of seconds to run all formula processing before logging a "
"timeout error."
msgstr ""

#: arelle/CntlrCmdLine.py:957
msgid "Truncate interpolated expressions in formula messages to this length."
msgstr ""

