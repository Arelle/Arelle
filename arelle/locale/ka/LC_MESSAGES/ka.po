msgstr ""

#: arelle/CntlrCmdLine.py:521
msgid "Report an error for any input that is not Inline XBRL."
msgstr ""

#: arelle/CntlrCmdLine.py:528
msgid ""
"Exit with a code indicating validation results: `0` = valid, no issues "
"`2` = usage error (existing parser.error usage) `3` = validation errors "
"found (and/or warnings if `--captureWarnings` is also used)"
msgstr ""

