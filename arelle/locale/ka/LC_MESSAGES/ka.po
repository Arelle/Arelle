msgstr ""

#: arelle/CntlrCmdLine.py:866
msgid "Log reference object properties (default)."
msgstr ""

#: arelle/CntlrCmdLine.py:873
msgid "Do not log reference object properties."
msgstr ""

#: arelle/CntlrCmdLine.py:881
msgid ""
"Truncate XML log file attribute values at length. The default is "
"`4,096,000` for JSON content and `128` for everything else."
msgstr ""

#: arelle/CntlrCmdLine.py:890
msgid ""
"Collect profile statistics, such as timing of validation activities and "
