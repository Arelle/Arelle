    "labels": [
      {
        "forObject": "ixt-sec:boolballotbox",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms boolean ballot box values to boolean true/false. A value of '☑' or '☒' is considered true, while '☐' is considered false."
      },
      {
        "forObject": "ixt-sec:countrynameen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms English country names into ISO 3166 2-character codes. Initial character of each word may be upper or lower case. Transforms English country names (as of the below revision date). Some words optional when in the official name (\"the\" and trailing words not customarily used even though in the ISO name). Some synonyms in the expression (USA, UK or Great Britain, etc)."
      },
      {
        "forObject": "ixt-sec:datequarterend",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms datequarterend. Transforms date in quarter - year expression representing the last day of a calendar quarter (e.g., last day in March, June, September and December)."
      },
      {
        "forObject": "ixt-sec:durday",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms durday. Transforms duration in days Accepts decimal number for days."
      },
      {
        "forObject": "ixt-sec:durhour",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms durday. Transforms duration in hours Accepts decimal number for hours."
      },
      {
        "forObject": "ixt-sec:durmonth",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms durmonth. Transforms duration in months Accepts decimal number for months."
      },
      {
        "forObject": "ixt-sec:durweek",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms durweek. Transforms duration in weeks Accepts decimal number for weeks."
      },
      {
        "forObject": "ixt-sec:durwordsen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms durations with number words or numbers for years, months, and/or days. Transforms number word durations (English). Duration year/month/day parts are expressed only in short-form notation words or numerals. Years, months and days up to 1999 (nineteen-hundred ninety-nine). Examples: three years four months no days, or three years, 11 months and four days Plural is optional. Comma and \"and\" are optional. Dashes allowed."
      },
      {
        "forObject": "ixt-sec:duryear",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms duryear. Transforms duration in years Accepts decimal number for years."
      },
      {
        "forObject": "ixt-sec:edgarprovcountryen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms English province or country names into 2-character codes specified in Appendix A of EDGARLink Online XML Technical Specification (https://www.sec.gov/info/edgar/specifications/edgarlinkonlinexml.htm). Initial character of each word may be upper or lower case. Transforms English province or country names (as of Version 27, April 2019 of EDGARLink Online XML Technical Specification). Some words optional when in the official name (\"the\" and trailing words not customarily used even though in the ISO name). Some synonyms in the expression (USA, UK or Great Britain, etc)."
      },
      {
        "forObject": "ixt-sec:entityfilercategoryen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms EDGAR Entity Filer Category into their enumeration codes. Initial character of each word may be upper or lower case. Transforms EDGAR Entity Filer Category into their enumeration codes (per SEC as of the below revision date)."
      },
      {
        "forObject": "ixt-sec:exchnameen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms exchange full English names to their corresponding short names. The conversion matrix is as follows : The New York Stock Exchange -> NYSE; New York Stock Exchange LLC -> NYSE; NASDAQ Global Select Market -> NASDAQ; The Nasdaq Stock Market LLC -> NASDAQ; BOX Exchange LLC -> BOX;Nasdaq BX, Inc. -> BX; Cboe C2 Exchange, Inc. -> C2; Cboe Exchange, Inc. -> CBOE; Chicago Stock Exchange, Inc. -> CHX; Cboe BYX Exchange, Inc. -> CboeBYX; Cboe BZX Exchange, Inc. -> CboeBZX; Cboe EDGA Exchange, Inc. -> CboeEDGA; Cboe EDGX Exchange, Inc. -> CboeEDGX; Nasdaq GEMX, LLC -> GEMX"
      },
      {
        "forObject": "ixt-sec:numwordsen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms number words into integer numbers. Transforms number words (English). Numbers are expressed only in short-form notation (where billion is 1000 x million). Fractions are not supported (neither supporting checkbook style writing such as one hundred one and 01/100, nor word fractions, such as par value two-thirds) The word and is allowed before sub-hundred words, e.g., three thousand and thirty-five. Commas are allowed where 1000 group separators are valid."
      },
      {
        "forObject": "ixt-sec:stateprovnameen",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms English state and province names into ISO 3166 2-character codes. Initial character of each word may be upper or lower case. Transforms English state and province names (as of the below revision date). Some words optional when in the official name (\"the\" and trailing words not customarily used even though in the ISO name)."
      },
      {
        "forObject": "ixt-sec:yesnoballotbox",
        "language": "en",
        "labelType": "xbrl:documentation",
        "value": "Transforms yesnoballotbox characters (empty, checked and x'ed) into Yes/No. Transforms the Unicode empty ballot box character \"☐\" into \"No\", and both checked \"☑\" and x'ed \"☒\" ballot box characters into \"Yes\". (http://www.codetable.net/decimal/9744) ."
      }
    ],
