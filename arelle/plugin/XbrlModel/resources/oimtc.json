            },
            {
                "forObject": "oimtc:duplicateSummationItemRelationship",
                "language": "en",
                "value": "Duplicate Summation-Item Relationship",
                "labelType": "xbrl:label"
            },
            {
                "forObject": "oimtc:duplicateSummationItemRelationship",
                "language": "en",
                "value": "There must not be more than one summation-item relationship with the same total concept and the same contributing concept within a single calculation.",
                "labelType": "xbrl:errorMessage"
            },
            {
                "forObject": "oimtc:summationItemConceptNotInCube",
